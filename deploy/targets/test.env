# Deploy target: TEST (camelot / test.mydragonmath.com)
#
# Non-secret configuration only. Every secret lives in $DM_ROOT/shared/.env on
# the target box and is never committed — see deploy/README.md.
#
# Sourced by the deploy scripts via `deploy/lib/common.sh`. Override any value
# on the command line, e.g. `DM_GIT_REF=main deploy/release.sh -t test`.

DM_ENVIRONMENT=test

# ssh alias for the target box (must work non-interactively: BatchMode=yes).
DM_SSH_HOST=camelot

# Public hostname. Used for the nginx server_name, the TLS certificate,
# APP_PUBLIC_URL and the CORS allow-list.
DM_HOSTNAME=test.mydragonmath.com

# The box's public IP. deploy/verify.sh pins its HTTPS checks to this address
# (curl --resolve) so it always tests the box we deployed to, not wherever the
# operator's resolver currently thinks the hostname lives. Right after a DNS
# cutover a stale cached record can point the hostname at the OLD host, and an
# unpinned verifier would then cheerfully report on the wrong server.
DM_TARGET_IP=20.118.216.118

# Release layout root on the target. Contains releases/, shared/, current.
DM_ROOT=/srv/dragon-math

# pm2 application name. Deliberately suffixed so it can never collide with
# production's `dragonmath-api` if the two ever share a box or a pm2 dump.
DM_PM2_APP=dragonmath-api-test

# Cluster mode with >1 instance is what makes `pm2 reload` zero-downtime: pm2
# restarts workers one at a time while the others keep serving.
DM_PM2_INSTANCES=2
DM_PM2_EXEC_MODE=cluster

# The API listens here; nginx proxies to it. 127.0.0.1 keeps the port off the
# public interface (server/index.js honours API_HOST).
DM_API_PORT=4070
DM_API_HOST=127.0.0.1

# Source of the build.
DM_GIT_REMOTE=https://github.com/lindsayleeds/dragon-math.git
DM_GIT_REF=main

# Guard for deploy/db-push.sh: the Supabase project ref the schema may be
# pushed to. This is an allow-list, not a deny-list — a push aborts unless
# DATABASE_URL points at exactly this project, so no typo or stale shared/.env
# can aim drizzle-kit at production. A project ref is an identifier, not a
# credential; the password stays in shared/.env.
DM_EXPECTED_DB_REF=palrxtqpdgtpelpyqwwu

# How many release directories to keep (older ones are pruned after a deploy).
DM_KEEP_RELEASES=5

# Block search engines: disallow-all robots.txt + X-Robots-Tag: noindex in every
# nginx location. Read by robots_substitutions() in deploy/lib/common.sh, which
# renders the site template, and asserted (in both directions) by verify.sh.
# Unset defaults to 1, so forgetting it cannot make a target indexable.
# MUST stay 1 for any non-production target.
DM_ROBOTS_NOINDEX=1

# Whether scheduled jobs are expected to be ARMED on this box. verify.sh asserts
# against it instead of hardcoding one environment's answer; unset means 0.
#
# 0 here, and it must stay 0: the weekly digest emails real parents through
# Resend and the orphan sweep deletes children past their grace period, and this
# box shares its Supabase project with nothing that would make that safe. With 0
# verify.sh requires that the boot log says jobs were NOT registered AND that
# shared/.env has ENABLE_CRON off. See server/lib/cronSchedule.js for why a bare
# truthiness check on ENABLE_CRON was the original bug.
DM_EXPECT_CRON=0

# Contact address for the Let's Encrypt registration.
DM_CERTBOT_EMAIL=mydragonmath@gmail.com
