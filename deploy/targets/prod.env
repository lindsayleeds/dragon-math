# Deploy target: PRODUCTION (sondapor / mydragonmath.com)
#
# Non-secret configuration only. Every secret lives in $DM_ROOT/shared/.env on
# the target box and is never committed — see deploy/README.md.
#
# Sourced by the deploy scripts via `deploy/lib/common.sh`. Override any value
# on the command line, e.g. `DM_GIT_REF=<sha> deploy/release.sh -t prod`.
#
# ─────────────────────────────────────────────────────────────────────────────
# Live since the 2026-07-28 cutover. Nothing here is used until you also pass
# DM_I_MEAN_PRODUCTION=1 (see the bottom of this file). A routine deploy is
# `deploy/release.sh -t prod --ref <sha>`.
# ─────────────────────────────────────────────────────────────────────────────

DM_ENVIRONMENT=production

# ssh alias for the target box (must work non-interactively: BatchMode=yes).
DM_SSH_HOST=sondapor

# Public hostname. Used for the nginx server_name, the TLS certificate,
# APP_PUBLIC_URL and the CORS allow-list.
DM_HOSTNAME=mydragonmath.com

# Extra names the site answers on, space-separated. Production serves the apex
# AND www from one server block, and the live certificate already covers both,
# so this must stay set: provision.sh sends one -d per name here, and dropping
# the alias would issue a REDUCED certificate and stop serving www.
# verify.sh asserts each alias is on the certificate and serving.
DM_HOSTNAME_ALIASES=www.mydragonmath.com

# The box's public IP. deploy/verify.sh pins its HTTPS checks to this address
# (curl --resolve) so it always tests the box we deployed to, not wherever the
# operator's resolver currently thinks the hostname lives.
DM_TARGET_IP=20.121.64.94

# Release layout root on the target. Contains releases/, shared/, current.
DM_ROOT=/srv/dragon-math

# pm2 application name. Deliberately NOT `dragonmath-api`, which was the old
# hand-started fork-mode process that served the site out of the git checkout at
# ~/repos/dragon-math. The cutover ran the two side by side — released stack up
# and verified, then nginx pointed at it and the old app deleted — and reusing the
# name would have made `pm2 startOrReload` adopt the running entry, taking the
# live site down as its first act. The old app is gone; the name stays as-is
# because renaming it now would buy nothing and cost a restart.
DM_PM2_APP=dragonmath-api-prod

# Cluster mode with >1 instance is what makes `pm2 reload` zero-downtime: pm2
# restarts workers one at a time while the others keep serving.
#
# This is safe as of the removal of live PvP. It was not before: PvP kept
# presence and matches in per-process Maps, so two players on different workers
# could not see each other. Nothing holds per-process state now — the rate
# limiter counts in the rate_limits table — and there are no websockets left.
DM_PM2_INSTANCES=2
DM_PM2_EXEC_MODE=cluster

# The API listens here; nginx proxies to it. 127.0.0.1 keeps the port off the
# public interface (server/index.js honours API_HOST).
#
# 4071, not 4070, because the cutover needed the old process (which held 4070)
# alive alongside this one. 4070 is free again now, but moving back would be a
# pointless restart — nothing else cares which port nginx proxies to. sondapor is
# shared with ~10 other pm2 apps, using 4002/4003, 4010/4011 … 4080, 4090.
#
# Worth recording what the cutover fixed here: the old process listened on
# *:4070 — EVERY interface — because it predated the loopback bind fix (#13).
# The public internet could not reach it (the network ACL filters the port), but
# anything that could reach the box over the network got a plaintext API that
# bypassed nginx TLS. server/lib/bindHost.js now keeps it on DM_API_HOST below,
# and verify.sh asserts it.
DM_API_PORT=4071
DM_API_HOST=127.0.0.1

# Source of the build.
DM_GIT_REMOTE=https://github.com/lindsayleeds/dragon-math.git
DM_GIT_REF=main

# Guard for deploy/db-push.sh: the Supabase project ref the schema may be
# pushed to. This is an allow-list, not a deny-list — a push aborts unless
# DATABASE_URL points at exactly this project, so no typo or stale shared/.env
# can aim drizzle-kit at the wrong database. A project ref is an identifier, not
# a credential; the password stays in shared/.env.
#
# This is a DIFFERENT Supabase project from the test target's
# (palrxtqpdgtpelpyqwwu), which is the whole point of the guard: the two
# environments share no database, so a stale shared/.env or a mistyped -t cannot
# have drizzle-kit rewrite the wrong one.
#
# Note what a push against THIS database means: the repo commits no migrations,
# so `drizzle-kit push` diffs schema.js against the live database and DROPS what
# it considers surplus. Take a Supabase backup first, every time.
DM_EXPECTED_DB_REF=sebxkwxhhkiitesligfc

# How many release directories to keep (older ones are pruned after a deploy).
DM_KEEP_RELEASES=5

# Search engines must index the real site. This is the ONLY target that sets 0,
# and verify.sh asserts it in both directions: with 0 it requires that NO checked
# path carries X-Robots-Tag: noindex and that robots.txt does not disallow all —
# so a stale noindex left over from a template change gets caught here rather
# than by watching search traffic disappear.
DM_ROBOTS_NOINDEX=0

# Scheduled jobs are ARMED here, and this is the only target where that is true:
# the weekly digest emails real parents through Resend and the orphan sweep
# deletes children past their grace period. verify.sh requires the boot log to
# say jobs WERE registered and shared/.env to have ENABLE_CRON on.
#
# shared/.env must therefore set ENABLE_CRON=1 — and it needs a working
# RESEND_API_KEY with it. Without the key the digest job logs a send it never
# performed (issue #2), which is worse than being off, because the failure is
# invisible. Only pm2 cluster instance 0 schedules, so cluster mode does not
# multiply the emails.
DM_EXPECT_CRON=1

# Contact address for the Let's Encrypt registration.
DM_CERTBOT_EMAIL=mydragonmath@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Every script refuses this target unless DM_I_MEAN_PRODUCTION=1 is also in the
# environment (deploy/lib/common.sh). That guard is deliberate and worth keeping
# now that the pipeline exists — it is the difference between a typo'd -t and a
# deploy to the live site:
#
#   DM_I_MEAN_PRODUCTION=1 deploy/verify.sh -t prod
#
# verify.sh is fully green on this target (43 checks) and is the read-only proof
# of the box's state; run it after every release.
# ─────────────────────────────────────────────────────────────────────────────
