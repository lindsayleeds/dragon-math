# dragon-math — nginx site for a released-artifact deployment.
#
# Rendered by deploy/provision.sh from this template. Unlike production's
# hand-edited /etc/nginx/sites-available/mydragonmath.com, this file IS version
# controlled: edit the template and re-run provision, never edit on the box.
#
# Mirrors production's caching and proxying behaviour (see docs/NGINX.md), with
# two differences for a non-production target:
#   * document root is the `current` symlink, not a git checkout
#   * search indexing is blocked (robots.txt + X-Robots-Tag)
#
# The DM_NOINDEX_HEADER and DM_ROBOTS_LOCATION placeholders below are computed
# from the target's DM_ROBOTS_NOINDEX by robots_substitutions() in
# deploy/lib/common.sh — envsubst has no conditionals, so the decision is made in
# shell and only its result is interpolated here. Both render empty when a target
# turns indexing back on. (Do not spell them with the dollar-brace syntax in a
# comment: envsubst would substitute there too, and a multi-line value would
# escape the comment and become live config.)
#
# The noindex header placeholder appears in every location on purpose. nginx's
# add_header is NOT inherited into a location that declares its own add_header,
# so a single server-level directive would silently vanish on exactly the
# responses (index.html, /assets/, version.json) that matter most.

server {
    server_name ${DM_SERVER_NAMES};

    # The release currently activated by deploy/release.sh. Swapping this
    # symlink is the deploy; nginx needs no reload for a static-only change.
    root ${DM_ROOT}/current/dist;
    index index.html;

    # Keep certbot's http-01 renewals working without touching this config.
    location /.well-known/acme-challenge/ {
        root ${DM_ROOT}/acme;
        default_type "text/plain";
    }

    # Non-production content must never be indexed alongside the real site.
    ${DM_ROBOTS_LOCATION}

    location /api/ {
        ${DM_NOINDEX_HEADER}
        proxy_pass http://127.0.0.1:${DM_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # index.html and version.json must never be cached: a deploy replaces the
    # asset filenames they point at, and a stale index.html asks the browser for
    # chunks that no longer exist. See src/components/RouteErrorBoundary.jsx.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        ${DM_NOINDEX_HEADER}
    }

    location = /version.json {
        add_header Cache-Control "no-cache, must-revalidate" always;
        ${DM_NOINDEX_HEADER}
    }

    # Content-hashed build output — safe to cache forever. try_files ... =404
    # (rather than falling back to the SPA) so a request for a chunk that this
    # release does not have fails fast instead of returning HTML.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        ${DM_NOINDEX_HEADER}
        try_files $uri =404;
    }

    location / {
        ${DM_NOINDEX_HEADER}
        try_files $uri $uri/ @ssr;
    }

    # SPA routes fall through to Express, which serves dist/index.html with the
    # per-kid PWA manifest injected. docs/NGINX.md explains why this cannot be
    # a plain static index.html.
    location @ssr {
        ${DM_NOINDEX_HEADER}
        proxy_pass http://127.0.0.1:${DM_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/${DM_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DM_HOSTNAME}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DM_SERVER_NAMES};

    location /.well-known/acme-challenge/ {
        root ${DM_ROOT}/acme;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
