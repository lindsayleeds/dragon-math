# PRODUCTION — mydragonmath.com, www.mydragonmath.com
#
# Non-secret facts only. The database password lives in Secret Manager and
# reaches these scripts through a short-lived --env-file; see deploy/README.md.
#
# Nothing here is used until you also pass DM_I_MEAN_PRODUCTION=1.

DM_ENVIRONMENT=production

# Cloud Run service backing this environment (project honorable-502113,
# region us-central1).
DM_SERVICE=dragon-math-prod

DM_HOSTNAME=mydragonmath.com

# The Supabase project this environment's database MUST be. Every script here
# resolves DATABASE_URL and refuses to act if the project ref does not match.
DM_EXPECTED_DB_REF=sebxkwxhhkiitesligfc
