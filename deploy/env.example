# Template for $DM_ROOT/shared/.env on a deploy target.
#
# NO REAL VALUES IN THIS FILE — it is committed. Fill a copy outside the repo,
# install it with `deploy/provision.sh -t <target> --env-file <copy>`, then
# delete the copy. On the box it lives at shared/.env, mode 600, and every
# release symlinks to it, so a rollback never restores stale secrets.
#
# .env.example in the repo root documents what each variable does; this file
# records what a *deployed non-production target* must set differently, and why.

# ── must differ from production ──────────────────────────────────────────────

# Scheduled jobs OFF. The weekly digest emails real parents and the orphan
# cleanup DELETES children past their grace period; neither belongs on a test
# box. An explicit 0 beats NODE_ENV=production — see server/lib/cronSchedule.js.
# deploy/provision.sh refuses an env file that enables cron on a non-prod target.
ENABLE_CRON=0

# The isolated test Supabase project. NEVER production's. deploy/db-push.sh
# checks the project ref in this URL against the target's DM_EXPECTED_DB_REF
# before it will let drizzle-kit touch the database.
DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Freshly generated per environment: `openssl rand -hex 32`. Sharing this with
# production would mean a token minted on the test box authenticates as the same
# user against production.
JWT_SECRET=

# This target's own hostname. Used in outgoing email links.
APP_PUBLIC_URL=https://test.mydragonmath.com

# server/index.js hardcodes only localhost + mydragonmath.com as default CORS
# origins, so any other hostname has to be named explicitly.
CORS_ORIGINS=https://test.mydragonmath.com

# Own admin password, not production's.
ADMIN_PASSWORD=

# ── email: log, never deliver ───────────────────────────────────────────────
# Leave RESEND_API_KEY empty and set EMAIL_STUB=1 so outgoing mail is printed to
# the pm2 log instead of sent. This is the second, independent layer of
# protection against a test box mailing real customers.
RESEND_API_KEY=
EMAIL_STUB=1
WEEKLY_REPORT_FROM=My Dragon Math (TEST) <no-reply@mydragonmath.com>

# ── Stripe: leave entirely blank unless you have TEST-mode keys ─────────────
# Blank = billing disabled; /api/billing checkout and portal return 503 and the
# rest of the app is unaffected. Only ever sk_test_/pk_test_ values here.
# provision.sh REFUSES to install an env file containing an sk_live_/pk_live_
# key on a non-production target.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_CLASSROOM_MONTHLY=
STRIPE_PRICE_CLASSROOM_YEARLY=

# ── safe to share with production (public identifiers / non-billing) ────────
# An OAuth *client id* is public — it ships in the JS bundle. The hostname still
# has to be added to that client's Authorized JavaScript origins in Google Cloud
# Console before the Google button works; see deploy/README.md.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional. Handle moderation fails open if unset, so a test box can omit it.
ANTHROPIC_API_KEY=

# Not needed at runtime — only scripts/generate-spelling-audio.cjs uses it.
ELEVENLABS_API_KEY=
