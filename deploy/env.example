# Template for the --env-file the database scripts take.
#
# This is NOT application configuration: the running app gets its configuration
# and secrets from Secret Manager, bound to the Cloud Run service. This file
# exists only so deploy/db-push.sh, deploy/db-harden.sh and
# deploy/admin-account.sh can reach the database directly.
#
# Write it immediately before a run, chmod 600, and delete it afterwards:
#
#   umask 077
#   printf 'DATABASE_URL=%s\n' \
#     "$(gcloud secrets versions access latest --secret=dragon-math-prod-database-url \
#          --project honorable-502113)" > /tmp/dm.env
#   DM_I_MEAN_PRODUCTION=1 deploy/admin-account.sh -e prod --env-file /tmp/dm.env \
#     --email person@example.com --action grant
#   shred -u /tmp/dm.env
#
# Exactly ONE DATABASE_URL assignment. The scripts refuse a file with more,
# because dotenv keeps the last one and the file would not mean what it looks
# like it means.
DATABASE_URL=
