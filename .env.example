# Server env vars. Copy to `.env` (which is gitignored) and fill in real values.

# JWT signing secret for auth tokens. Generate with: openssl rand -hex 32
# REQUIRED — there is no default. server/middleware/auth.js refuses to load
# without it, because the old fallback was a literal in the repo and every session
# in the app is derived from this value.
JWT_SECRET=

# Public base URL used in outgoing emails (e.g. weekly digest "Open dashboard").
APP_PUBLIC_URL=http://localhost:5173

# Scheduled jobs (weekly parent digest + orphan cleanup). Read as a *boolean*:
# 1/true/yes/on arms them; 0/false/no/off explicitly disables them even under
# NODE_ENV=production. Unset falls back to NODE_ENV=production. Under pm2
# cluster mode only instance 0 schedules, so N workers don't send N digests.
# See server/lib/cronSchedule.js.
ENABLE_CRON=0

# --- Email (weekly parent digest + school-admin invites, via Resend) ---
# API key from resend.com -> API Keys. If unset, sendEmail() FAILS LOUDLY by
# default so a missing key can never silently drop mail in a deployment. For
# local dev without a key, set EMAIL_STUB=1 to print the HTML to stdout instead
# (logged as status 'stubbed'). This guard is independent of NODE_ENV.
RESEND_API_KEY=
# Local dev only: log emails to stdout instead of sending when no key is set.
EMAIL_STUB=0
# From address for outgoing mail. MUST use a Resend-verified domain — the
# no-reply@dragonmath.local default is a placeholder that Resend will reject.
WEEKLY_REPORT_FROM=My Dragon Math <no-reply@mydragonmath.com>
# Blind-copy recipient for school-admin welcome emails (record of who was
# invited). Defaults to mydragonmath@gmail.com if unset.
WELCOME_EMAIL_BCC=

# Supabase Postgres connection string (Session pooler — supports prepared statements).
# Find it in: Supabase dashboard -> Project Settings -> Database -> Connection string -> Session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# --- Connection pool bounds (server/lib/pgPool.js owns the defaults + reasoning) ---
# All optional, and left commented out on purpose: unset means "use the built-in
# default", which is the supported configuration and the one that tracks the code.
# Set one only to override it. Milliseconds; 0 disables a timeout (and disables
# keepalive). Raise DB_STATEMENT_TIMEOUT_MS first if a legitimate query starts
# getting cancelled with SQLSTATE 57014 ("canceling statement due to statement
# timeout"). The values shown are the current defaults.
#DB_POOL_MAX=10
#DB_POOL_CONNECT_TIMEOUT_MS=10000
#DB_POOL_IDLE_TIMEOUT_MS=30000
#DB_POOL_KEEPALIVE_DELAY_MS=10000
#DB_STATEMENT_TIMEOUT_MS=15000
#DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Budget for the /admin roster reports only (withLongQueryBudget in server/db.js).
#DB_LONG_STATEMENT_TIMEOUT_MS=60000

# Google OAuth 2.0 Web Client ID (Google Cloud Console -> APIs & Services -> Credentials).
# Same value goes in both vars: GOOGLE_OAUTH_CLIENT_ID is read by the server,
# VITE_GOOGLE_OAUTH_CLIENT_ID is baked into the frontend bundle at build time.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Sign in with Apple (POST /api/auth/apple). Comma-separated client ids an Apple
# identity token's `aud` may be: the iOS app's bundle id AND the web Services ID
# (VITE_APPLE_SERVICES_ID below) — a web token's `aud` is the Services ID, so
# leaving it out makes every web Apple sign-in a 401. Empty = the route answers
# 503. No secret is needed — tokens are checked against Apple's public keys.
# Setup steps: docs/APPLE_SIGN_IN.md.
APPLE_CLIENT_IDS=
# Revoking a parent's Sign in with Apple grant when they delete their account in
# the app. Optional: unset, deletion still works and revocation is skipped with a
# warning. The private key is the .p8 contents; "\n" escapes are accepted.
# APPLE_TEAM_ID (the 10-character Team ID) is also the app id prefix in
# /.well-known/apple-app-site-association, which makes kid /k/ and family
# /family/ links open the iOS app. Unset, that file says TEAM_ID_PLACEHOLDER
# and links keep opening the web app.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Web "Continue with Apple" button (Sign in with Apple JS, popup mode). Baked
# into the frontend bundle at build time. The Services ID, and a Return URL
# registered on it exactly (e.g. https://<your-domain>/parent/auth). Leave
# either empty and the button is hidden.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=

# ElevenLabs text-to-speech for Dragon Spelling prompts. Two consumers:
#   * scripts/generate-spelling-audio.cjs (npm run spelling:audio) — offline,
#     pre-generates the built-in GRADE catalogs into public/audio/spelling/.
#   * server/lib/spellingAudio.js — AT RUNTIME, when a grown-up or child saves a
#     CUSTOM word list. Those MP3s go into the shared `spelling_audio` table
#     (nginx serves a per-release dist/, so runtime files can't live on disk).
# Without a key the runtime path degrades to the browser's built-in speech, so
# the game still works. The offline generator requires a key unless it is run
# with `--context-only`.
ELEVENLABS_API_KEY=
# Voice for custom-list prompts. Talia ("Warm Soft Guide") is ElevenLabs' own
# replacement for the retired Sarah voice: calm, unhurried, neutral General
# American, with the cleanest consonant articulation of the new roster — which
# is exactly what a spelling drill needs.
#
# The runtime cache is keyed by (word, voice), so CHANGING THIS makes every
# already-generated custom word invisible until it is re-made: run
# `npm run spelling:backfill` afterwards to regenerate the custom lists.
#
# NOTE: the 541 static grade-catalog files in public/audio/spelling/ were
# generated with the old Sarah voice and have deliberately NOT been redone, so
# grade rounds still speak in Sarah while custom lists speak in Talia. The two
# never mix inside a round (each round draws from one source).
ELEVENLABS_VOICE_ID=ZLR2VL7jAuie9sowsXqg
# Offline built-in catalog generation uses this separate voice so newly added
# grade words and contextual prompts continue to match the 541 Sarah files. If
# this changes, run `npm run spelling:audio -- --force` to redo the static files.
ELEVENLABS_STATIC_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# An ENGLISH model matters for isolated words: multilingual_v2 has no language
# anchor for a single context-free word and drifts to continental vowels
# ("van" → "vawn"). Leave unset to get the eleven_turbo_v2 default.
ELEVENLABS_MODEL_ID=

# --- Anthropic AI ---
# Shared by handle moderation and spelling-context detection. When set,
# kid-chosen handles are screened by a Claude model for lewd/nasty content
# (incl. sneaky spellings) before an account is created. Leave blank to keep
# moderation OFF — signups behave exactly as before. Get a key at
# console.anthropic.com. On any API error the moderation check fails open.
ANTHROPIC_API_KEY=
# Optional: model used for the check. Defaults to claude-haiku-4-5 (fast/cheap).
# Set to claude-opus-4-8 for maximum nuance at higher cost.
HANDLE_MODERATION_MODEL=
# Optional model for deciding whether a new spelling word needs sentence
# context and writing that sentence. Uses ANTHROPIC_API_KEY above and defaults
# to the same fast/cheap Claude Haiku tier. Failed checks stay pending and are
# retried on a later list save or `npm run spelling:backfill`.
SPELLING_CONTEXT_MODEL=

# --- Networking ---
# Interface the API binds to. Defaults to 127.0.0.1 (loopback only) so the
# plaintext API can't be reached around nginx's TLS. Leave blank in the normal
# nginx-on-the-same-box topology; set it (e.g. 0.0.0.0) only when the proxy
# lives in a different network namespace, such as inside a container.
API_HOST=
# Port the API listens on. Production runs 4070 (see docs/NGINX.md); dev
# defaults to 3001, which is what the Vite dev proxy expects.
API_PORT=

# --- Deploy / health ---
# Optional build identifier reported by GET /api/health when the app runs with
# no built dist/version.json (dev, or an API-only host). Leave blank and health
# reports "unknown"; the built dist/version.json always wins over this.
GIT_SHA=

# Admin access uses individual accounts. See docs/ADMIN.md.

# --- Stripe billing (Phase 2 — see docs/MONETIZATION.md) ---
# Server secret key (test: sk_test_..., live: sk_live_...). Leave blank to keep
# billing disabled — checkout/portal return 503 and the app runs fine without it.
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` (dev) or the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs (Stripe Dashboard -> Products). One per plan + billing interval.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_CLASSROOM_MONTHLY=
STRIPE_PRICE_CLASSROOM_YEARLY=

# --- App Store subscriptions (iOS — see docs/APP_STORE.md) ---
# Bundle id of the iOS app. Leave blank to keep App Store Server Notifications
# disabled — POST /api/appstore/notifications returns 503 and nothing else changes.
APPSTORE_BUNDLE_ID=
# 'Production' (default) or 'Sandbox'. Nothing else is accepted: the Xcode and
# LocalTesting environments skip signature verification.
APPSTORE_ENVIRONMENT=
# The app's numeric Apple ID (App Store Connect -> App Information). Required
# for Production.
APPSTORE_APP_APPLE_ID=
# Set to 'false' to skip OCSP revocation checks of Apple's signing certificates.
# Leave blank (on) in production.
APPSTORE_ONLINE_CHECKS=
# Comma-separated App Store product ids that grant Premium (e.g. monthly,yearly).
APPSTORE_PREMIUM_PRODUCT_IDS=
